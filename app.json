{
  "expo": {
    "name": "Marietta Baseball Academy",
    "slug": "marietta-baseball-academy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mariettabaseballacademy",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mariettabaseballacademy.app",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1B40",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mariettabaseballacademy.app",
      "versionCode": 2
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#F7F7F5",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1B40",
          "image": "./assets/images/transparent.png",
          "imageWidth": 0
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e29ec69f-e933-4bf2-b89b-7344e35a23e5"
      }
    }
  }
}
